NODE_ENV=development
DEPLOYMENT_MODE=
# RAILWAY_ENVIRONMENT_NAME is set by Railway on every deployment; never set it yourself.
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/injurysub
INJURYSUB_DB_PORT=5432
APP_BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=injurysub_session
SESSION_SECRET=dev-session-secret-change-me
SIGN_IN_CODE_TTL_MINUTES=10
SESSION_TTL_DAYS=90
EMAIL_DELIVERY_MODE=console
EMAIL_FROM_ADDRESS=noreply@example.com
RESEND_API_KEY=
ESPN_MODE=stub
ESPN_SEND_MODE=never
ESPN_SCENARIO=
ESPN_S2=
ESPN_SWID=
LEAGUE_ID=
SEASON_YEAR=2027
WORKER_HEALTH_PORT=3001
WORKER_SWEEP_INTERVAL_MS=15000
WORKER_INTERNAL_URL=http://127.0.0.1:3001
WORKER_INTERNAL_TOKEN=dev-worker-internal-token-change-me
REQUEST_EXPIRY_HOURS=12
