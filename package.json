{
  "name": "fantasy-autosub",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @injurysub/web --filter @injurysub/worker dev",
    "dev:web": "pnpm --filter @injurysub/web dev",
    "dev:worker": "pnpm --filter @injurysub/worker dev",
    "build": "pnpm --filter @injurysub/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @injurysub/db db:generate",
    "db:migrate": "pnpm --filter @injurysub/db db:migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

