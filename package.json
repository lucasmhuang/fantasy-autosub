{
  "name": "fantasy-autosub",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --parallel --filter @injurysub/web --filter @injurysub/worker dev",
    "dev:web": "pnpm --filter @injurysub/web dev",
    "dev:worker": "pnpm --filter @injurysub/worker dev",
    "build": "pnpm --filter @injurysub/web build",
    "format": "pnpm exec biome check --write .",
    "format:check": "pnpm exec biome ci .",
    "lint": "pnpm exec eslint apps/web --max-warnings=0",
    "lint:fix": "pnpm exec eslint apps/web --fix",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm --filter @injurysub/web build",
    "hooks:install": "pnpm exec lefthook install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "bash ./scripts/dev-postgres.sh start",
    "db:stop": "bash ./scripts/dev-postgres.sh stop",
    "db:down": "bash ./scripts/dev-postgres.sh down",
    "db:logs": "bash ./scripts/dev-postgres.sh logs",
    "db:generate": "pnpm --filter @injurysub/db db:generate",
    "db:migrate": "pnpm --filter @injurysub/db db:migrate",
    "db:studio": "pnpm --filter @injurysub/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.1.0",
    "lefthook": "^2.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
